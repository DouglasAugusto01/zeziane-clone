# Número de WhatsApp da loja (DDI + DDD + número, somente dígitos, sem espaços ou símbolos)
# Exemplo: 55 (Brasil) + 11 (DDD de SP) + número
NEXT_PUBLIC_WHATSAPP_NUMBER=5500000000000

# ID de métricas do Google Analytics 4 (formato G-XXXXXXXXXX).
# Veja como criar em analytics.google.com — deixe em branco para não carregar
# o Google Analytics (ex: em desenvolvimento local).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
